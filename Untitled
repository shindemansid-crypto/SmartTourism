def api_request(params):
    params["format"] = "json"

    url = API + "?" + urllib.parse.urlencode(params)

    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": "SmartTourismCollegeProject/1.0"
        }
    )

    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


def find_photo(search_text):
    data = api_request({
        "action": "query",
        "generator": "search",
        "gsrsearch": search_text + " filetype:bitmap",
        "gsrnamespace": 6,
        "gsrlimit": 8,
        "prop": "imageinfo",
        "iiprop": "url|mime",
        "iiurlwidth": 1200,
    })

    pages = data.get("query", {}).get("pages", {})

    for page in pages.values():
        info = page.get("imageinfo", [])

        if not info:
            continue

        image = info[0]
        mime = image.get("mime", "")

        if mime in ("image/jpeg", "image/png", "image/webp"):
            return image.get("thumburl") or image.get("url")

    return None


def download_image(filename, search_text):
    print(f"Searching: {search_text}")

    try:
        image_url = find_photo(search_text)

        if not image_url:
            print(f"  NOT FOUND: {filename}")
            return

        request = urllib.request.Request(
            image_url,
            headers={
                "User-Agent": "SmartTourismCollegeProject/1.0"
            }
        )

        with urllib.request.urlopen(request, timeout=60) as response:
            data = response.read()

        path = OUT / filename
        path.write_bytes(data)

        print(f"  SAVED: {filename}")

    except Exception as error:
        print(f"  ERROR: {filename}")
        print(f"  {error}")


for filename, search_text in IMAGES.items():
    download_image(filename, search_text)

